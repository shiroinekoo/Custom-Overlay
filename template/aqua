<!DOCTYPE html>
<html>
<head>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Quicksand:wght@700;800&display=swap');

    :root {
        --aqua-blue: #00c6ff;      
        --aqua-yellow: #ffdf00;    
        --aqua-light-blue: #00e5ff;
        --text-white: #ffffff;    
    }

    * {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        background: transparent !important;
        font-family: 'Quicksand', sans-serif;
        color: var(--text-white);
        overflow: hidden !important;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .wrapper {
        position: relative;
        width: 100%;
        max-width: 800px;
        height: 200px;
        display: flex;
        align-items: flex-end;
        padding-top: 45px; 
        padding-right: 15px;
    }

    .container {
        position: relative;
        width: 100%;
        height: 135px;
        display: flex;
        align-items: center;
        padding: 10px 160px 10px 20px; 
        border-radius: 16px;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.6);
    }

    .background-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        border-radius: 16px;
    }

    .container::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(10, 25, 50, 0.85), rgba(0, 40, 80, 0.75));
        border-radius: 16px;
        z-index: 1;
    }

    .mascot {
        position: absolute;
        bottom: 0;
        right: 10px; 
        z-index: 3;
        height: 180px; 
        pointer-events: none;
        display: flex;
        align-items: flex-end;
    }

    .mascot img {
        height: 100%;
        width: auto;
        object-fit: contain;
        display: block;
        filter: drop-shadow(0px 4px 10px rgba(0, 0, 0, 0.85));
    }

    .left-content {
        position: relative;
        z-index: 2;
        width: 100%;
        text-align: center;
    }

    .text {
        font-size: 24px; 
        font-weight: 800;
        letter-spacing: 0.03rem;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
        line-height: 1.3;
        overflow-wrap: break-word;
    }

    .amount {
        color: var(--aqua-yellow);
        font-weight: 800;
        font-size: 26px;
        text-shadow: 0 0 10px rgba(255, 223, 0, 0.6), 2px 2px 4px rgba(0, 0, 0, 0.9);
    }

    .donator {
        color: var(--aqua-light-blue);
        font-weight: 800;
        font-size: 26px;
        text-shadow: 0 0 10px rgba(0, 229, 255, 0.6), 2px 2px 4px rgba(0, 0, 0, 0.9);
    }

    .message {
        display: block;
        margin-top: 6px;
        font-family: 'Fredoka', sans-serif;
        font-size: 20px;
        font-weight: 600;
        color: #ffffff;
        text-shadow: 0 2px 6px rgba(0, 0, 0, 0.95), 0 0 4px rgba(0, 0, 0, 0.8);
    }
</style>
</head>
<body>

<div class="wrapper">
    <div class="container">
        <img alt="Background" src="https://images7.alphacoders.com/136/thumb-1920-1365927.png" class="background-img">
        
        <div class="left-content">
            <div class="text">
                <div>
                    <span class="amount">{{formattedAmount}}</span> Dari <span class="donator">{{gifterName}}</span>
                </div>
                <span class="message">{{message}}</span>
            </div>
        </div>
    </div>

    <div class="mascot">
        <img src="https://raw.githubusercontent.com/shiroinekoo/Tako-Overlay/main/asset/mascot/Aqua-Konosuba.png" alt="Aqua Mascot">
    </div>
</div>

</body>
</html>
