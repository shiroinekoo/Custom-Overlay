<!DOCTYPE html>
<html>
<head>
<style>
    /* Import Font Google: Cinzel Decorative (Tajam & Magis) & Rajdhani (Modern & Stylized) */
    @import url('https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Rajdhani:wght@600;700&display=swap');

    :root {
        /* Palet Warna Tema Yato Noragami */
        --yato-cyan: #00f0ff;       /* Biru Cyan Khas Mata Yato */
        --yato-gold: #ffd700;       /* Kuning Emas Koin 5 Yen / Mahkota Dewa */
        --yato-red: #ff385c;        /* Merah Aksen Seka / Katana */
        --text-white: #f0f8ff;      /* Putih Ice Blue */
        
        /* Warna Glow & Neon Banner */
        --neon-blue-bright: #38b6ff;
        --blue-glow: rgba(0, 240, 255, 0.6);
        --gold-glow: rgba(255, 215, 0, 0.6);
    }

    * {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        background: transparent;
        font-family: 'Rajdhani', sans-serif;
        color: var(--text-white);
        overflow: hidden !important;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .wrapper {
        position: relative;
        width: 100%;
        max-width: 800px;
        height: 200px;
        display: flex;
        align-items: flex-end;
        padding-top: 40px; 
    }

    .container {
        position: relative;
        width: 100%;
        height: 140px; 
        display: flex;
        align-items: center;
        padding: 10px 20px 10px 170px; 
        border-radius: 16px;
        
        /* Frame Neon Tema Yato */
        border: 2px solid var(--neon-blue-bright);
        box-shadow: 
            0 0 6px var(--blue-glow),
            0 0 12px var(--blue-glow),
            0 0 20px rgba(0, 240, 255, 0.35),
            0 6px 16px rgba(0, 0, 0, 0.85);
    }

    .background-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        border-radius: 16px;
    }

    .container::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        /* Overlay Gelap Kebiruan khas malam Noragami */
        background: linear-gradient(135deg, rgba(5, 12, 28, 0.82), rgba(15, 5, 25, 0.78));
        border-radius: 16px;
        z-index: 1;
    }

    .mascot {
        position: absolute;
        bottom: 0;
        left: 10px; 
        z-index: 3;
        height: 185px; 
        pointer-events: none;
        display: flex;
        align-items: flex-end;
    }

    .mascot img {
        height: 100%;
        width: auto;
        object-fit: contain;
        display: block;
        filter: drop-shadow(0px 4px 12px rgba(0, 240, 255, 0.5)) drop-shadow(4px 6px 8px rgba(0, 0, 0, 0.9));
    }

    .left-content {
        position: relative;
        z-index: 2;
        width: 100%;
        text-align: center;
    }

    /* Font Judul Utama */
    .text {
        font-family: 'Cinzel Decorative', serif;
        font-size: 23px;
        font-weight: 900;
        letter-spacing: 0.05rem;
        text-shadow: 0 0 10px var(--blue-glow), 2px 2px 5px rgba(0, 0, 0, 0.95);
        line-height: 1.3;
        overflow-wrap: break-word;
    }

    /* Nominal / Amount -> Warna Emas Koin 5 Yen */
    .amount {
        color: var(--yato-gold);
        font-weight: 900;
        text-shadow: 0 0 10px var(--gold-glow), 2px 2px 4px rgba(0, 0, 0, 0.9);
    }

    /* Nama Donatur -> Warna Cyan Mata Yato */
    .donator {
        color: var(--yato-cyan);
        font-weight: 900;
        text-shadow: 0 0 10px var(--blue-glow), 2px 2px 4px rgba(0, 0, 0, 0.9);
    }

    /* Pesan Donasi */
    .message {
        font-family: 'Rajdhani', sans-serif;
        display: block;
        margin-top: 4px;
        font-size: 18px;
        font-weight: 700;
        color: var(--text-white);
        letter-spacing: 0.03rem;
        text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.95), 0 0 6px rgba(0, 0, 0, 0.8);
    }
</style>
</head>
<body>

<div class="wrapper">
    <div class="container">
        <img alt="Background" src="https://raw.githubusercontent.com/shiroinekoo/Tako-Overlay/main/asset/background/Noragami.jpg" class="background-img">
        
        <div class="left-content">
            <div class="text">
                <div>
                    <span class="amount">{{formattedAmount}}</span> Dari <span class="donator">{{gifterName}}</span>
                </div>
                <span class="message">{{message}}</span>
            </div>
        </div>
    </div>

    <div class="mascot">
        <img src="https://raw.githubusercontent.com/shiroinekoo/Tako-Overlay/main/asset/mascot/Yato-Noragami.png" alt="Yato Mascot">
    </div>
</div>

</body>
</html>
