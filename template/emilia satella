<!DOCTYPE html>
<html>
<head>
<style>
    /* Import Font Google: Cinzel (Gaya Elegant/Fantasy) & Poppins (Bersih & Mudah Dibaca) */
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800&family=Poppins:wght@500;700&display=swap');

    :root {
        /* Palet Warna Tema Emilia */
        --emilia-purple: #c495f0;  /* Ungu Violet Khas Ornamen Emilia */
        --emilia-mint: #74f3df;    /* Hijau Mint Khas Kristal Puck */
        --text-white: #f5f0fa;     /* Putih Lembut Keunguan */
        
        /* Warna Neon */
        --neon-purple-bright: #d9b3ff; /* Warna inti neon yang lebih terang */
        --purple-glow: rgba(196, 149, 240, 0.6);
        --mint-glow: rgba(116, 243, 223, 0.6);
    }

    * {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        background: transparent;
        font-family: 'Poppins', sans-serif;
        color: var(--text-white);
        overflow: hidden !important;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .wrapper {
        position: relative;
        width: 100%;
        max-width: 800px;
        height: 200px;
        display: flex;
        align-items: flex-end;
        padding-top: 40px; 
    }

    .container {
        position: relative;
        width: 100%;
        height: 140px; 
        display: flex;
        align-items: center;
        padding: 10px 20px 10px 170px; 
        border-radius: 16px;
        
        /* --- PENAMBAHAN EFEK NEON DI SINI --- */
        border: 2px solid var(--neon-purple-bright); /* Garis tepi tipis terang */
        box-shadow: 
            0 0 5px var(--purple-glow),               /* Glow dalam halus */
            0 0 10px var(--purple-glow),              /* Glow luar sedang */
            0 0 15px rgba(196, 149, 240, 0.4),        /* Glow luar tipis lebar */
            0 6px 16px rgba(0, 0, 0, 0.7);            /* Bayangan dasar agar teks terbaca */
        /* ------------------------------------ */
    }

    .background-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        border-radius: 16px;
    }

    .container::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(15, 10, 25, 0.75); /* Sedikit lebih gelap agar neon kontras */
        border-radius: 16px;
        z-index: 1;
    }

    .mascot {
        position: absolute;
        bottom: 0;
        left: 10px; 
        z-index: 3;
        height: 185px; 
        pointer-events: none;
        display: flex;
        align-items: flex-end;
    }

    .mascot img {
        height: 100%;
        width: auto;
        object-fit: contain;
        display: block;
        filter: drop-shadow(4px 6px 8px rgba(0, 0, 0, 0.85));
    }

    .left-content {
        position: relative;
        z-index: 2;
        width: 100%;
        text-align: center;
    }

    /* Font Judul / Teks Utama */
    .text {
        font-family: 'Cinzel', serif;
        font-size: 25px;
        font-weight: 800;
        letter-spacing: 0.06rem;
        text-shadow: 0 0 10px var(--purple-glow), 2px 2px 5px rgba(0, 0, 0, 0.95);
        line-height: 1.3;
        overflow-wrap: break-word;
    }

    /* Nominal / Amount -> Warna Hijau Mint */
    .amount {
        color: var(--emilia-mint);
        font-weight: 800;
        text-shadow: 0 0 8px var(--mint-glow), 1px 1px 3px rgba(0, 0, 0, 0.9);
    }

    /* Nama Donatur -> Warna Ungu Violet */
    .donator {
        color: var(--emilia-purple);
        font-weight: 800;
        text-shadow: 0 0 8px var(--purple-glow), 1px 1px 3px rgba(0, 0, 0, 0.9);
    }

    /* Pesan Donasi */
    .message {
        font-family: 'Poppins', sans-serif;
        display: block;
        margin-top: 6px;
        font-size: 16px;
        font-weight: 500;
        color: var(--text-white);
        text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.95);
    }
</style>
</head>
<body>

<div class="wrapper">
    <div class="container">
        <img alt="Background" src="https://translationchicken.com/wp-content/uploads/2016/11/mansion.png?w=1400" class="background-img">
        
        <div class="left-content">
            <div class="text">
                <div>
                    <span class="amount">{{formattedAmount}}</span> Dari <span class="donator">{{gifterName}}</span>
                </div>
                <span class="message">{{message}}</span>
            </div>
        </div>
    </div>

    <div class="mascot">
        <img src="https://raw.githubusercontent.com/shiroinekoo/Tako-Overlay/main/asset/mascot/Emilia.png" alt="Emilia Mascot">
    </div>
</div>

</body>
</html>
