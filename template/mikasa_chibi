<!DOCTYPE html>
<html>
<head>
<style>
    /* Import Font bertema Attack on Titan */
    @font-face {
        font-family: 'AOTFont';
        src: url('https://fonts.cdnfonts.com/s/72813/Tschichold-Bold.woff') format('woff');
        font-weight: bold;
    }

    :root {
        /* Palet Warna Mikasa */
        --jacket-brown: #c88d46;   /* Coklat Jaket Scout Regiment */
        --scarf-red: #ff3b3b;      /* Merah Syal Mikasa */
        --text-white: #ffffff;     /* Putih */
    }

    * {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        background: transparent;
        font-family: 'AOTFont', 'Forte', 'Impact', sans-serif;
        color: var(--text-white);
        overflow: hidden !important;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Wrapper diberi padding-top agar kepala Mikasa tidak terpotong saat mencuat */
    .wrapper {
        position: relative;
        width: 100%;
        max-width: 800px;
        height: 200px;
        display: flex;
        align-items: flex-end;
        padding-top: 40px; /* Ruang ekstra di atas untuk efek pop-out */
    }

    .container {
        position: relative;
        width: 100%;
        height: 140px; /* Tinggi bingkai latar belakang */
        display: flex;
        align-items: center;
        padding: 10px 20px 10px 170px; /* Padding kiri besar (170px) agar teks tidak menutupi Mikasa */
        border-radius: 16px;
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.7);
    }

    .background-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        border-radius: 16px;
    }

    .container::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.65);
        border-radius: 16px;
        z-index: 1;
    }

    /* Maskot Mikasa di Sebelah Kiri dengan Efek Pop-out (Mencuat ke Atas) */
    .mascot {
        position: absolute;
        bottom: 0;
        left: 10px; 
        z-index: 3;
        height: 185px; /* Dibuat lebih tinggi dari container (140px) agar kepalanya keluar */
        pointer-events: none;
        display: flex;
        align-items: flex-end;
    }

    .mascot img {
        height: 100%;
        width: auto;
        object-fit: contain;
        display: block;
        filter: drop-shadow(4px 6px 8px rgba(0, 0, 0, 0.85));
    }

    .left-content {
        position: relative;
        z-index: 2;
        width: 100%;
        text-align: center;
    }

    /* Ukuran Teks Donasi */
    .text {
        font-size: 24px; 
        font-weight: 800;
        letter-spacing: 0.05rem;
        text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.95);
        line-height: 1.25;
        overflow-wrap: break-word;
    }

    /* Nominal Uang: Coklat */
    .amount {
        color: var(--jacket-brown);
        font-weight: 800;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
    }

    /* Nama Pengirim: Merah */
    .donator {
        color: var(--scarf-red);
        font-weight: 800;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
    }

    /* Isi Pesan: Putih */
    .message {
        display: block;
        margin-top: 6px;
        font-size: 17px;
        font-weight: 600;
        color: var(--text-white);
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
    }
</style>
</head>
<body>

<div class="wrapper">
    <div class="container">
        <img alt="Background" src="https://i.pinimg.com/1200x/3c/e6/d4/3ce6d41cfecdb135214b58d19bcd22c5.jpg" class="background-img">
        
        <div class="left-content">
            <div class="text">
                <div>
                    <span class="amount">IDR 160.000</span> Dari <span class="donator">NavLeb</span>
                </div>
                <span class="message">Semangat terus live-nya bang! 🔥 Semoga makin makin lancar rezeki & streaming-nya via Tako ⚔️✨</span>
            </div>
        </div>
    </div>

    <div class="mascot">
        <!-- Gambar Mikasa dipindah menggunakan path asset terbaru (diubah ke bentuk raw link agar tampil di OBS) -->
        <img src="https://raw.githubusercontent.com/shiroinekoo/Tako-Overlay/main/asset/mascot/Mikasa-Ackerman-PNG-Cutout.png" alt="Mikasa Mascot">
    </div>
</div>

</body>
</html>
