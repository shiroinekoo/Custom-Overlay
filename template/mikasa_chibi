<!DOCTYPE html>
<html>
<head>
<style>
    /* Import Font bertema Attack on Titan */
    @font-face {
        font-family: 'AOTFont';
        src: url('https://fonts.cdnfonts.com/s/72813/Tschichold-Bold.woff') format('woff');
        font-weight: bold;
    }

    :root {
        /* Palet Warna */
        --jacket-brown: #c88d46;   /* Coklat Jaket Scout Regiment */
        --scarf-red: #ff3b3b;      /* Merah Syal Mikasa */
        --text-white: #ffffff;     /* Putih */
    }

    * {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        background: transparent;
        font-family: 'AOTFont', 'Forte', 'Impact', sans-serif;
        color: var(--text-white);
        overflow: hidden !important;
    }

    .wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        padding: 12px 15px 0px 5px; 
    }

    .container {
        position: relative;
        width: 100%;
        display: flex;
        align-items: center;
        padding: 12px 140px 12px 20px;
        border-radius: 16px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.6);
        height: calc(100% - 3px);
    }

    .background-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        border-radius: 16px;
    }

    .container::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.65);
        border-radius: 16px;
        z-index: 1;
    }

    .mascot {
        position: absolute;
        top: 0;
        bottom: 0;
        right: 10px;
        z-index: 3;
        height: 100%;
        pointer-events: none;
        display: flex;
        align-items: center;
    }

    .mascot img {
        height: 100%;
        width: auto;
        object-fit: contain;
        display: block;
        filter: drop-shadow(4px 4px 6px rgba(0, 0, 0, 0.85));
    }

    .left-content {
        position: relative;
        z-index: 2;
        width: 100%;
        text-align: center;
    }

    .text {
        font-size: 22px; 
        font-weight: 800;
        letter-spacing: 0.05rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.95);
        line-height: 1.3;
        overflow-wrap: break-word;
    }

    /* Nominal Uang: Coklat */
    .amount {
        color: var(--jacket-brown);
        font-weight: 800;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
    }

    /* Nama Pengirim: Merah */
    .donator {
        color: var(--scarf-red);
        font-weight: 800;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
    }

    /* Isi Pesan: Putih */
    .message {
        display: block;
        margin-top: 4px;
        font-size: 16px;
        font-weight: 600;
        color: var(--text-white);
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
    }
</style>
</head>
<body>

<div class="wrapper">
    <div class="container">
        <img alt="Background" src="https://i.pinimg.com/1200x/3c/e6/d4/3ce6d41cfecdb135214b58d19bcd22c5.jpg" class="background-img">
        
        <div class="left-content">
            <div class="text">
                <div>
                    <span class="amount">{{formattedAmount}}</span> Dari <span class="donator">{{gifterName}}</span>
                </div>
                <span class="message">{{message}}</span>
            </div>
        </div>
    </div>

    <div class="mascot">
        <img src="https://raw.githubusercontent.com/shiroinekoo/Custom-Overlay/main/asset/Mikasa-Ackerman-PNG-Cutout.png" alt="Mikasa Mascot">
    </div>
</div>

</body>
</html>
