<!DOCTYPE html>
<html>
<head>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;700;800&display=swap');

    :root {
        --amount-color: rgb(255, 133, 225);
        --text-color: #ffffff;
    }

    * {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        background: transparent;
        font-family: 'Poppins', sans-serif;
        color: var(--text-color);
        overflow: hidden !important;
    }

    /* Padding wrapper dikurangi untuk menambah tinggi banner 4px lagi */
    .wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        padding: 12px 15px 0px 5px; 
    }

    /* Tinggi container bertambah 4px (dari -11px ke -3px) */
    .container {
        position: relative;
        width: 100%;
        display: flex;
        align-items: center;
        padding: 12px 140px 12px 20px;
        border-radius: 16px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.6);
        height: calc(100% - 3px);
    }

    .background-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        border-radius: 16px;
    }

    .container::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.55);
        border-radius: 16px;
        z-index: 1;
    }

    /* Posisi maskot tetap sejajar presisi */
    .mascot {
        position: absolute;
        top: 0;
        bottom: 0;
        right: 10px;
        z-index: 3;
        height: 100%;
        pointer-events: none;
        display: flex;
        align-items: center;
    }

    .mascot img {
        height: 100%;
        width: auto;
        object-fit: contain;
        display: block;
        filter: drop-shadow(4px 4px 6px rgba(0, 0, 0, 0.85));
    }

    .left-content {
        position: relative;
        z-index: 2;
        width: 100%;
        text-align: center;
    }

    /* Teks Alert */
    .text {
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: 0.05rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.95);
        line-height: 1.3;
        overflow-wrap: break-word;
    }

    .amount, .donator {
        color: var(--amount-color);
        font-weight: 800;
    }

    .message {
        display: block;
        margin-top: 4px;
        font-size: 0.95rem;
        font-weight: 600;
    }
</style>
</head>
<body>

<div class="wrapper">
    <div class="container">
        <img alt="Background" src="https://i.pinimg.com/1200x/3c/e6/d4/3ce6d41cfecdb135214b58d19bcd22c5.jpg" class="background-img">
        
        <div class="left-content">
            <div class="text">
                <div>
                    <span class="amount">{{formattedAmount}}</span> Dari <span class="donator">{{gifterName}}</span>
                </div>
                <span class="message">{{message}}</span>
            </div>
        </div>
    </div>

    <div class="mascot">
        <img src="https://raw.githubusercontent.com/shiroinekoo/Custom-Overlay/main/Mikasa-Ackerman-PNG-Cutout.png" alt="Mikasa Mascot">
    </div>
</div>

</body>
</html>
